LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
# Agent-only capacity of the exact LLM_MODEL. REQUIRED for real providers;
# leave blank for mock's synthetic W=65536, O=4096. Never assume a real window.
AGENT_CONTEXT_WINDOW=
AGENT_MAX_OUTPUT_TOKENS=
AGENT_CONTEXT_SAFETY_TOKENS=1024
# Optional independent model input/output limits (tokens).
AGENT_MODEL_INPUT_LIMIT=
AGENT_MODEL_OUTPUT_LIMIT=
AGENT_CONTEXT_TRIGGER_RATIO=0.8
AGENT_CONTEXT_TARGET_RATIO=0.6
AGENT_CONTEXT_TARGET_BUDGET_RATIO=0.8
# DeepSeek: max_tokens; compatible endpoints may require max_completion_tokens.
AGENT_OUTPUT_TOKEN_PARAMETER=max_tokens
# Old-turn compaction uses the same provider/model/window; at most TWO calls per turn.
# Preflight and overflow recovery SHARE those two calls, including failures.
# One safe main-request overflow retry per turn; no retries after partial stream output.
# Session admission is process-local: deploy one API worker.
# Recent complete-turn allowance (preference); second attempt halves it.
COMPACTION_RECENT_RATIO=0.16
# Summary body target is distinct from generation cap (which may include reasoning).
COMPACTION_TARGET_TOKENS=1200
COMPACTION_MAX_OUTPUT_TOKENS=4096
PDF_PARSER=pymupdf
GROBID_BASE_URL=http://localhost:8070
PDF_PARSER_TIMEOUT=30
PAPER_INFO_TOOL_AGENT_ENABLED=true
PAPER_INFO_WEB_ENRICH_ENABLED=false
PAPER_INFO_PROFILE_ENABLED=false
PAPER_LOOKUP_TIMEOUT=10
PAPER_LOOKUP_MAX_RESULTS=5
PAPER_LOOKUP_PROVIDERS=arxiv,crossref,openalex
SECTION_REPAIR_LLM_ENABLED=false
SECTION_REPAIR_MAX_ROUNDS=1
PLAN_AGENT_LLM_ENABLED=false
PLAN_AGENT_MAX_INPUT_CHARS=3000
PLAN_AGENT_CONFIDENCE_THRESHOLD=0.7
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3
CHAT_HISTORY_MAX_MESSAGES=20
TOOL_MAX_PARALLEL_CALLS=10
# Total serialized model-visible characters per Tool result (all papers combined).
TOOL_RESULT_MAX_CHARS=12000
# Text characters per versioned read; actual serialized result is also bounded.
TOOL_READ_MAX_CHARS=2000
